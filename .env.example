# Falcon Player REST endpoint on the LAN (e.g. http://192.168.1.42)
VITE_FPP_URL=http://192.168.1.XXX

# Remote Falcon viewer/API base URL for song requests
VITE_RF_URL=https://hillardlightshows.remotefalcon.com

# FPP command preset names for outdoor speaker control
VITE_AUDIO_ON_PRESET=KIOSK_AUDIO_ON
VITE_AUDIO_OFF_PRESET=KIOSK_AUDIO_OFF

# How long outdoor audio stays on before auto-off (seconds)
VITE_AUDIO_DURATION_SECONDS=360

# How often to poll FPP for show status (milliseconds)
VITE_POLL_INTERVAL_MS=1000

# When true, the kiosk simulates FPP and RF instead of talking to them
VITE_DEMO_MODE=true

# In demo mode, use a shorter audio countdown for testing
VITE_DEMO_AUDIO_SECONDS=30

# PIN required to enter admin mode (NOT a real security boundary)
VITE_ADMIN_PIN=1031
