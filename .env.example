# Falcon Player REST endpoint on the LAN (e.g. http://192.168.1.42)
VITE_FPP_URL=http://192.168.1.XXX

# Remote Falcon API base and show identifier
VITE_RF_BASE_URL=https://remotefalcon.com/remote-falcon-viewer
VITE_RF_SUBDOMAIN=hillardlightshows

# Poll cadence for RF getShow (ms). Presence heartbeat cadence (ms).
VITE_RF_POLL_MS=3000
VITE_RF_PRESENCE_MS=30000

# FPP Volume Set levels (0–100) used for outdoor speaker control.
# The audio button fires FPP's built-in "Volume Set" command directly,
# so this works even if the FPP has no command presets configured.
VITE_AUDIO_ON_VOLUME=100
VITE_AUDIO_OFF_VOLUME=0

# PipeWire sink targeted by the audio button. FPP plays each sequence to
# one group-sink only — so to send audio to both the rock speakers AND
# the FM transmitter, both USB cards live inside a single group ("Rock
# Speakers") and this points at the per-card sink for the speaker amp.
# Muting the card kills the driveway speakers while the FM card in the
# same group keeps playing. Empty string = global Volume Set.
# Query live sinks: curl http://<fpp>/api/pipewire/audio/targets
VITE_AUDIO_TARGET=sink:fpp_fx_g1_codec

# How long outdoor audio stays on before auto-off (seconds)
VITE_AUDIO_DURATION_SECONDS=360

# How often to poll FPP for show status (milliseconds)
VITE_POLL_INTERVAL_MS=1000

# When true, the kiosk simulates FPP and RF instead of talking to them.
# Set to false to hit the real Remote Falcon API.
VITE_DEMO_MODE=true

# In demo mode, use a shorter audio countdown for testing
VITE_DEMO_AUDIO_SECONDS=30

# PIN required to enter admin mode (NOT a real security boundary).
# Leave empty for no PIN, or set to any digit string.
VITE_ADMIN_PIN=

# Which season the kiosk is dressed for. Flips the header emoji and label.
# halloween | christmas
VITE_SEASON=halloween
VITE_SEASON_YEAR=2026
